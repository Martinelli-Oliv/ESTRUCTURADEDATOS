import java.util.Scanner;

public class Carrera {
	public static void main(String[] args) {
		Scanner scanner = new Scanner(System.in);

		int mejorVehiculo = 0;
		double mejorTiempo = Double.MAX_VALUE;

		for (int i = 1; i <= 4; i++) {
			System.out.print("Ingrese el número de vehículo: ");
			int vehiculo = scanner.nextInt();

			System.out.print("Ingrese el tiempo en segundos: ");
			double tiempo = scanner.nextDouble();

			if (tiempo < mejorTiempo) {
				mejorTiempo = tiempo;
				mejorVehiculo = vehiculo;
			}
		}

		System.out.println("El vehículo con el mejor tiempo es el número "
				+ mejorVehiculo + ".");
		System.out.println("Tiempo realizado: " + mejorTiempo + " segundos.");

		scanner.close();
	}
}
