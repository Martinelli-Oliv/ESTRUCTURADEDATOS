import java.util.Scanner;

public class Camiones {
	public static void main(String[] args) {
		Scanner scanner = new Scanner(System.in);
		Camion[] camiones = new Camion[30];
		int cantidadTe = 0;

		for (int i = 0; i < camiones.length; i++) {
			System.out.println("Camión " + (i + 1));
			System.out.print("Patente: ");
			String patente = scanner.nextLine();
			System.out.print("Nombre y apellido del chofer: ");
			String chofer = scanner.nextLine();
			System.out.print("Tipo de carga (madera, yerba o té): ");
			String tipoCarga = scanner.nextLine();
			System.out.print("Hora de egreso: ");
			String horaEgreso = scanner.nextLine();

			camiones[i] = new Camion(patente, chofer, tipoCarga, horaEgreso);
			if (tipoCarga.equalsIgnoreCase("te") || tipoCarga.equalsIgnoreCase("té")) {
				cantidadTe++;
			}
		}

		System.out.println("\nDatos de los camiones:");
		for (Camion camion : camiones) {
			System.out.println("Patente: " + camion.patente
					+ " | Chofer: " + camion.chofer
					+ " | Carga: " + camion.tipoCarga
					+ " | Hora de egreso: " + camion.horaEgreso);
		}
		System.out.println("\nCantidad de camiones que cargaron té: " + cantidadTe);
		scanner.close();
	}

	static class Camion {
		String patente, chofer, tipoCarga, horaEgreso;

		Camion(String patente, String chofer, String tipoCarga, String horaEgreso) {
			this.patente = patente;
			this.chofer = chofer;
			this.tipoCarga = tipoCarga;
			this.horaEgreso = horaEgreso;
		}
	}
}
